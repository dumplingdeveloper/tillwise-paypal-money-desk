{
  "name": "tillwise-store-agent-mcp-server",
  "version": "0.1.0",
  "description": "Streamable HTTP MCP server for Tillwise Store Agent WordPress abilities.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "sandbox:smoke": "npm run build --silent && node dist/src/sandboxSmoke.js",
    "sandbox:seed": "npm run build --silent && node dist/src/sandboxSeed.js",
    "sandbox:public-creds": "npm run build --silent && node dist/src/sandboxPublicCreds.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "typescript": "5.9.3"
  }
}
