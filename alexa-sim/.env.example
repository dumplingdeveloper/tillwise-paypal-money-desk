# Required by default so live/demo commands cannot accidentally use the wrong Copilot account.
EXPECTED_GITHUB_LOGIN=
# Judges can opt out explicitly when using their own Copilot account.
# ALLOW_ANY_GITHUB_LOGIN=1
# Optional BYOK fine-grained GitHub token with Copilot Requests permission.
# COPILOT_GITHUB_TOKEN=github_pat_...
# Optional model override.
# COPILOT_MODEL=gpt-6-luna
# Bring your own model key instead of Copilot (no GitHub login needed). See README "Judge quick start".
# TILLWISE_LLM_PROVIDER=openai        # openai | anthropic | azure | ollama
# TILLWISE_LLM_MODEL=gpt-4o-mini       # required with a provider
# TILLWISE_LLM_API_KEY=                # never commit a real key
# TILLWISE_LLM_BASE_URL=               # optional; required for azure
